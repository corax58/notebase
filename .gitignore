# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (unanchored — matches node_modules anywhere: root, apps/web, apps/extension, packages/*)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js (apps/web)
.next/
out/

# production builds (any app)
build
dist

# plasmo (apps/extension)
.plasmo
apps/extension/build/
apps/extension/chrome-mv3-dev/
apps/extension/chrome-mv3-prod/
*.zip

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts